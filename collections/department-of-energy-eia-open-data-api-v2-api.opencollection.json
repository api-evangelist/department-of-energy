{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aeo EIA Open Data API V2 API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
