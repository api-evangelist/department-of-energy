{
  "opencollection": "1.0.0",
  "info": {
    "name": "EIA Open Data API V2 Aeo Seriesid API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Seriesid",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Legacy series ID lookup",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eia.gov/v2/seriesid/:seriesId",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "EIA Open Data API key."
              },
              {
                "name": "seriesId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns data for a legacy APIv1 series identifier."
        }
      ]
    }
  ],
  "bundled": true
}